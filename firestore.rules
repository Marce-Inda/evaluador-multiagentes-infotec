rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * 1. REGLAS PARA LA COLECCIÓN: solicitudes_convocatoria
     */
    match /solicitudes_convocatoria/{solicitudId} {
      // PÚBLICO: Cualquier persona interesada en tus redes puede enviar su registro (crear).
      allow create: if true;
      
      // ADMIN: Solo tú deberías poder leer, actualizar o rechazar solicitudes.
      //
      // OPCIÓN A (Producción Segura - Requiere que inicies sesión en Firebase Auth):
      // allow read, write: if request.auth != null && request.auth.token.email == "tu_correo_investigador@gmail.com";
      //
      // OPCIÓN B (Modo Rápido / Desarrollo - Abierto):
      // Permite lectura pública para que admin.html acceda sin configurar Firebase Auth.
      allow read, update, delete: if true; 
    }

    /*
     * 2. REGLAS PARA LA COLECCIÓN: codigos_acceso
     */
    match /codigos_acceso/{codigoId} {
      // PARTICIPANTES: Los usuarios en el arnés experimental pueden:
      // - Leer un código específico para validarlo (get).
      // - Actualizar el código para quemarlo (marcarlo como usado: true).
      allow get: if true;
      allow update: if true;
      
      // SEGURIDAD CRÍTICA: Ningún participante puede listar (list) todos los códigos.
      // Esto evita que un usuario curioso husmee en la base de datos y robe códigos no usados.
      allow list: if false;

      // ADMIN: Permite crear o borrar códigos de acceso.
      //
      // OPCIÓN A (Producción Segura):
      // allow create, delete: if request.auth != null && request.auth.token.email == "tu_correo_investigador@gmail.com";
      //
      // OPCIÓN B (Modo Rápido / Desarrollo):
      allow create, delete, read, list: if true;
    }

    /*
     * 3. REGLAS PARA LA COLECCIÓN: respuestas_experimentales
     */
    match /respuestas_experimentales/{respuestaId} {
      allow create, read, update, delete, list: if true;
    }
  }
}
